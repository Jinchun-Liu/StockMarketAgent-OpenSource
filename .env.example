# Runtime
APP_ENV=development
APP_NAME=StockMarketAgent
APP_VERSION=0.1.0
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL / pgvector
POSTGRES_DB=stock_assistant
POSTGRES_USER=stock_assistant
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://stock_assistant:change-me@postgres:5432/stock_assistant

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=stock-assistant
MINIO_ROOT_PASSWORD=change-me-too
MINIO_SECRET_KEY=change-me-too
MINIO_SECURE=false
MINIO_EVIDENCE_BUCKET=evidence
MINIO_ARTIFACT_BUCKET=artifacts

# Data providers. Leave blank until a licensed account is available.
CNINFO_ACCESS_KEY=
CNINFO_SECRET_KEY=
EASTMONEY_CHOICE_USERNAME=
EASTMONEY_CHOICE_PASSWORD=
TUSHARE_TOKEN=
ENABLE_SOCIAL_SOURCE=false

# Local OpenAI-compatible model server (vLLM)
LOCAL_LLM_BASE_URL=http://host.docker.internal:8100/v1
LOCAL_LLM_API_KEY=local-only
LOCAL_LLM_MODEL=Qwen/Qwen3.5-9B
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Optional external OpenAI-compatible provider. Disabled by default.
EXTERNAL_LLM_ENABLED=false
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=

# Privacy and feature gates
ALLOW_EXTERNAL_HOLDING_DATA=false
ENABLE_DIRECTIONAL_FORECAST=false
ENABLE_DESKTOP_NOTIFICATIONS=true

# R1 development source runtime. Production rejects both development modes.
R1_RUNTIME_MODE=demo_replay
ENABLE_R1_FIXTURE=true
ENABLE_R1_DEV_LIVE=false

# One-shot AWS preview. APP_ENV=preview additionally requires DEV_LIVE enabled,
# fixture mode disabled, a versioned S3 bucket, and the exact product commit.
AWS_REGION=ap-southeast-1
PUBLIC_SNAPSHOT_BUCKET=
PUBLIC_BASE_URL=
PRODUCT_COMMIT=
SNAPSHOT_FRESHNESS_GRACE_MINUTES=15
SNAPSHOT_ADVISORY_LOCK_ID=1105503150
PUBLIC_SMOKE_ATTEMPTS=3
