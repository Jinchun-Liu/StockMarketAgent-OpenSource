{
  "$defs": {
    "DirectAttachmentCandidate": {
      "additionalProperties": false,
      "properties": {
        "canonical_url": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https://",
          "title": "Canonical Url",
          "type": "string"
        },
        "href": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Href",
          "type": "string"
        },
        "href_ordinal": {
          "maximum": 11,
          "minimum": 0,
          "title": "Href Ordinal",
          "type": "integer"
        },
        "official_index": {
          "anyOf": [
            {
              "$ref": "#/$defs/OfficialDocumentIndexBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_candidate_id": {
          "format": "uuid",
          "title": "Parent Candidate Id",
          "type": "string"
        },
        "parent_receipt_id": {
          "format": "uuid",
          "title": "Parent Receipt Id",
          "type": "string"
        }
      },
      "required": [
        "parent_candidate_id",
        "canonical_url",
        "href",
        "href_ordinal",
        "parent_receipt_id"
      ],
      "title": "DirectAttachmentCandidate",
      "type": "object"
    },
    "FormalDocumentIdentity": {
      "additionalProperties": false,
      "properties": {
        "binding_basis": {
          "enum": [
            "official_index",
            "document_fields"
          ],
          "title": "Binding Basis",
          "type": "string"
        },
        "canonical_url": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https://",
          "title": "Canonical Url",
          "type": "string"
        },
        "document_kind": {
          "enum": [
            "annual",
            "interim",
            "announcement",
            "regulatory",
            "IR"
          ],
          "title": "Document Kind",
          "type": "string"
        },
        "identity_anchors": {
          "items": {
            "$ref": "#/$defs/FormalDocumentLocation"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Identity Anchors",
          "type": "array"
        },
        "instrument_id": {
          "pattern": "^(XSHG|XSHE|XBSE):[0-9]{6}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "issuer_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Issuer Name",
          "type": "string"
        },
        "native_document_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Native Document Id",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "document_kind",
        "issuer_name",
        "instrument_id",
        "title",
        "native_document_id",
        "canonical_url",
        "binding_basis",
        "identity_anchors"
      ],
      "title": "FormalDocumentIdentity",
      "type": "object"
    },
    "FormalDocumentLocation": {
      "additionalProperties": false,
      "description": "An original normalized character interval or an explicit metadata field.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "maximum": 350,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "start": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "field"
      ],
      "title": "FormalDocumentLocation",
      "type": "object"
    },
    "OfficialDocumentIndexBinding": {
      "additionalProperties": false,
      "description": "Adapter-produced exact row binding; validation alone does not grant trust.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/FormalDocumentIdentity"
        },
        "index_url": {
          "const": "https://www.cninfo.com.cn/new/hisAnnouncement/query",
          "title": "Index Url",
          "type": "string"
        },
        "publication": {
          "$ref": "#/$defs/PublicationDateEvidence"
        },
        "row_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Row Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "publication",
        "index_url",
        "row_id",
        "source_id"
      ],
      "title": "OfficialDocumentIndexBinding",
      "type": "object"
    },
    "PublicationDateEvidence": {
      "additionalProperties": false,
      "properties": {
        "canonical_url": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https://",
          "title": "Canonical Url",
          "type": "string"
        },
        "kind": {
          "enum": [
            "official_index",
            "official_file_metadata",
            "document_disclosure",
            "official_page_structured"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/FormalDocumentLocation"
        },
        "observation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "instant"
          ],
          "title": "Precision",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "raw_value": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "timezone": {
          "enum": [
            "Asia/Shanghai",
            "UTC"
          ],
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "raw_value",
        "published_at",
        "precision",
        "timezone",
        "canonical_url",
        "location",
        "observation_sha256",
        "receipt_id"
      ],
      "title": "PublicationDateEvidence",
      "type": "object"
    },
    "RobotsOriginStop": {
      "additionalProperties": false,
      "properties": {
        "http_status": {
          "enum": [
            401,
            403,
            429
          ],
          "title": "Http Status",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "origin": {
          "maxLength": 300,
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "http_status",
        "observed_at"
      ],
      "title": "RobotsOriginStop",
      "type": "object"
    },
    "SourceDiscoveryCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "direct_attachment": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectAttachmentCandidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "discovery_score": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Discovery Score",
          "type": "string"
        },
        "domain": {
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "title": "Domain",
          "type": "string"
        },
        "official_index": {
          "anyOf": [
            {
              "$ref": "#/$defs/OfficialDocumentIndexBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "schema_version": {
          "default": "1.1",
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "url",
        "title",
        "domain",
        "discovery_score"
      ],
      "title": "SourceDiscoveryCandidate",
      "type": "object"
    },
    "SourceDiscoveryDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "date_filtered": {
          "default": 0,
          "minimum": 0,
          "title": "Date Filtered",
          "type": "integer"
        },
        "domain_filtered": {
          "default": 0,
          "minimum": 0,
          "title": "Domain Filtered",
          "type": "integer"
        },
        "protocol_filtered": {
          "default": 0,
          "minimum": 0,
          "title": "Protocol Filtered",
          "type": "integer"
        },
        "raw_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Count"
        },
        "selected_count": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Selected Count",
          "type": "integer"
        }
      },
      "title": "SourceDiscoveryDiagnostics",
      "type": "object"
    },
    "SourceDiscoveryStatus": {
      "enum": [
        "succeeded",
        "no_results",
        "quota_exhausted",
        "failed"
      ],
      "title": "SourceDiscoveryStatus",
      "type": "string"
    }
  },
  "$id": "https://stock-market-agent.local/schemas/discovery/result.v1.3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/SourceDiscoveryCandidate"
      },
      "maxItems": 5,
      "title": "Candidates",
      "type": "array"
    },
    "credits_used": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Credits Used",
      "type": "integer"
    },
    "diagnostics": {
      "$ref": "#/$defs/SourceDiscoveryDiagnostics"
    },
    "provider": {
      "pattern": "^[a-z][a-z0-9_.-]{1,99}$",
      "title": "Provider",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "robots_origin_stop": {
      "anyOf": [
        {
          "$ref": "#/$defs/RobotsOriginStop"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.3",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "searched_at": {
      "format": "date-time",
      "title": "Searched At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SourceDiscoveryStatus"
    }
  },
  "required": [
    "schema_version",
    "provider",
    "status",
    "request_sha256",
    "searched_at"
  ],
  "title": "SourceDiscoveryResult",
  "type": "object",
  "x-contract-model": "stock_assistant.contracts.discovery.SourceDiscoveryResult",
  "x-schema-version": "1.3"
}
