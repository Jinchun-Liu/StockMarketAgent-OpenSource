{
  "$defs": {
    "ActiveTargetRevisionRef": {
      "additionalProperties": false,
      "description": "Immutable reference captured by a job before it leaves the scheduler process.",
      "properties": {
        "activated_at": {
          "format": "date-time",
          "title": "Activated At",
          "type": "string"
        },
        "instrument": {
          "$ref": "#/$defs/InstrumentRef"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "watchlist_id": {
          "format": "uuid",
          "title": "Watchlist Id",
          "type": "string"
        },
        "watchlist_revision": {
          "minimum": 1,
          "title": "Watchlist Revision",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "watchlist_id",
        "watchlist_revision",
        "instrument",
        "activated_at"
      ],
      "title": "ActiveTargetRevisionRef",
      "type": "object"
    },
    "InstrumentRef": {
      "additionalProperties": false,
      "description": "Market-neutral security identity suitable for future exchanges.",
      "properties": {
        "asset_class": {
          "default": "equity",
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "title": "Asset Class",
          "type": "string"
        },
        "currency": {
          "default": "CNY",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "exchange": {
          "pattern": "^[A-Z0-9_]{2,32}$",
          "title": "Exchange",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Z0-9_]+:[A-Za-z0-9._-]+$",
          "title": "Instrument Id",
          "type": "string"
        },
        "market": {
          "pattern": "^[A-Z0-9_]{2,32}$",
          "title": "Market",
          "type": "string"
        },
        "symbol": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "symbol",
        "exchange",
        "market"
      ],
      "title": "InstrumentRef",
      "type": "object"
    },
    "JobFailure": {
      "additionalProperties": false,
      "description": "Safe failure details; stack traces stay in observability storage.",
      "properties": {
        "failed_at": {
          "format": "date-time",
          "title": "Failed At",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Reason Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Safe Message",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "safe_message",
        "retryable",
        "failed_at"
      ],
      "title": "JobFailure",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "degraded",
        "skipped",
        "failed",
        "cancelled",
        "expired"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "PremarketBriefTaskResult": {
      "additionalProperties": false,
      "description": "Reference-only summary of a persisted deterministic briefing.",
      "properties": {
        "active_target": {
          "$ref": "#/$defs/ActiveTargetRevisionRef"
        },
        "briefing_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Briefing Id"
        },
        "data_manifest_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Manifest Hash"
        },
        "event_count": {
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "active_target",
        "window_start",
        "window_end",
        "event_count",
        "evidence_count"
      ],
      "title": "PremarketBriefTaskResult",
      "type": "object"
    }
  },
  "$id": "https://stock-market-agent.local/schemas/jobs/premarket-generate-result.v1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Briefing job result without embedding the briefing body in queue state.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PremarketBriefTaskResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "status",
    "attempt"
  ],
  "title": "PremarketBriefJobResult",
  "type": "object",
  "x-contract-model": "stock_assistant.contracts.premarket_jobs.PremarketBriefJobResult",
  "x-schema-version": "1.0"
}
