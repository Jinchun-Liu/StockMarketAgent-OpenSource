{
  "$defs": {
    "ResearchSessionStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "stalled",
        "expired",
        "deleted"
      ],
      "title": "ResearchSessionStatus",
      "type": "string"
    }
  },
  "$id": "https://stock-market-agent.local/schemas/jobs/research-generate-result.v1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "report_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResearchSessionStatus"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "job_id",
    "status",
    "completed_at"
  ],
  "title": "ResearchGenerateResult",
  "type": "object",
  "x-contract-model": "stock_assistant.contracts.research.ResearchGenerateResult",
  "x-schema-version": "1.0"
}
