{
  "$defs": {
    "PublicEvidenceIndexEntryV1": {
      "additionalProperties": false,
      "description": "One public evidence document addressable from its snapshot root.",
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "(^|/)\\.{1,2}(/|$)"
              }
            ]
          },
          "pattern": "^[a-zA-Z0-9._/-]+\\.json$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "path"
      ],
      "title": "PublicEvidenceIndexEntryV1",
      "type": "object",
      "x-runtime-invariants": [
        "path equals evidence/{event_id}.json"
      ]
    }
  },
  "$id": "https://stock-market-agent.local/schemas/public-snapshots/evidence-index.v1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict public index joining evidence event IDs to immutable JSON assets.",
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/PublicEvidenceIndexEntryV1"
      },
      "maxItems": 1000,
      "title": "Events",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "events"
  ],
  "title": "PublicEvidenceIndexV1",
  "type": "object",
  "x-contract-model": "stock_assistant.contracts.public_snapshots.PublicEvidenceIndexV1",
  "x-runtime-invariants": [
    "event_id and path values are each unique"
  ],
  "x-schema-version": "1.0"
}
