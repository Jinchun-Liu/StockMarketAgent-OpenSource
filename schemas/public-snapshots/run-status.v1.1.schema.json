{
  "$defs": {
    "PublicCapabilityRunState": {
      "description": "Publicly safe per-capability state without provider-owned details.",
      "enum": [
        "succeeded",
        "no_change",
        "gap",
        "blocked",
        "failed",
        "stale"
      ],
      "title": "PublicCapabilityRunState",
      "type": "string"
    },
    "PublicCapabilityRunStatus": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "safe_reason_code": {
                "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
                "type": "string"
              }
            },
            "required": [
              "safe_reason_code"
            ]
          },
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "succeeded",
                  "no_change"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "safe_reason_code": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Safe status projection; it deliberately excludes cursors, URLs and free text.",
      "properties": {
        "capability": {
          "pattern": "^[a-z][a-z0-9_.-]{1,99}$",
          "title": "Capability",
          "type": "string"
        },
        "safe_reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safe Reason Code"
        },
        "source_grade": {
          "$ref": "#/$defs/PublicSourceGrade"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_-]{2,99}$",
          "title": "Source Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/PublicCapabilityRunState"
        }
      },
      "required": [
        "source_id",
        "capability",
        "source_grade",
        "state"
      ],
      "title": "PublicCapabilityRunStatus",
      "type": "object"
    },
    "PublicRunState": {
      "description": "Terminal state of one bounded refresh run.",
      "enum": [
        "succeeded",
        "degraded",
        "failed"
      ],
      "title": "PublicRunState",
      "type": "string"
    },
    "PublicSourceGrade": {
      "description": "Stable public quality disclosure without provider-private state.",
      "enum": [
        "free_official_unverified",
        "free_structured_unverified",
        "dev_web_unverified",
        "demo_replay"
      ],
      "title": "PublicSourceGrade",
      "type": "string"
    }
  },
  "$id": "https://stock-market-agent.local/schemas/public-snapshots/run-status.v1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "properties": {
                "state": {
                  "enum": [
                    "succeeded",
                    "no_change"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "properties": {
                "state": {
                  "enum": [
                    "gap",
                    "blocked",
                    "failed"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "items": {
              "properties": {
                "state": {
                  "enum": [
                    "gap",
                    "blocked",
                    "failed",
                    "stale"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "degraded"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "properties": {
                "state": {
                  "enum": [
                    "gap",
                    "blocked",
                    "failed",
                    "stale"
                  ]
                }
              },
              "required": [
                "state"
              ]
            }
          }
        }
      }
    }
  ],
  "description": "Run status that permits an explicit all-unhealthy degraded preview.",
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/PublicCapabilityRunStatus"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PublicRunState"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "started_at",
    "completed_at",
    "status",
    "capabilities"
  ],
  "title": "PublicRunStatusV1_1",
  "type": "object",
  "x-contract-model": "stock_assistant.contracts.public_snapshots.PublicRunStatusV1_1",
  "x-runtime-invariants": [
    "completed_at >= started_at",
    "(source_id, capability) identities are unique",
    "snapshot_id matches the pointer and manifest",
    "completed_at <= manifest.generated_at",
    "source_grade values match manifest.origin_mode"
  ],
  "x-schema-version": "1.1"
}
