{
  "$defs": {
    "ClaimType": {
      "enum": [
        "fact",
        "system_inference",
        "model_hypothesis"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "CoverageGap": {
      "additionalProperties": false,
      "properties": {
        "actual_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual End"
        },
        "actual_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Start"
        },
        "area": {
          "pattern": "^[a-z][a-z0-9_.-]{1,99}$",
          "title": "Area",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Reason Code",
          "type": "string"
        },
        "requested_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Start"
        }
      },
      "required": [
        "area",
        "reason_code",
        "detail"
      ],
      "title": "CoverageGap",
      "type": "object"
    },
    "FormalDocumentCitation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "extraction_scope": {
          "enum": [
            "complete",
            "prefix_truncated",
            "selected_pages",
            "unknown"
          ],
          "title": "Extraction Scope",
          "type": "string"
        },
        "fact_locations": {
          "additionalProperties": {
            "$ref": "#/$defs/FormalDocumentLocation"
          },
          "maxProperties": 9,
          "minProperties": 1,
          "title": "Fact Locations",
          "type": "object"
        },
        "retrieval_receipt_id": {
          "format": "uuid",
          "title": "Retrieval Receipt Id",
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/FormalDocumentVerification"
        }
      },
      "required": [
        "document_id",
        "evidence_id",
        "verification",
        "retrieval_receipt_id",
        "extraction_scope",
        "fact_locations"
      ],
      "title": "FormalDocumentCitation",
      "type": "object"
    },
    "FormalDocumentIdentity": {
      "additionalProperties": false,
      "properties": {
        "binding_basis": {
          "enum": [
            "official_index",
            "document_fields"
          ],
          "title": "Binding Basis",
          "type": "string"
        },
        "canonical_url": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https://",
          "title": "Canonical Url",
          "type": "string"
        },
        "document_kind": {
          "enum": [
            "annual",
            "interim",
            "announcement",
            "regulatory",
            "IR"
          ],
          "title": "Document Kind",
          "type": "string"
        },
        "identity_anchors": {
          "items": {
            "$ref": "#/$defs/FormalDocumentLocation"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Identity Anchors",
          "type": "array"
        },
        "instrument_id": {
          "pattern": "^(XSHG|XSHE|XBSE):[0-9]{6}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "issuer_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Issuer Name",
          "type": "string"
        },
        "native_document_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Native Document Id",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "document_kind",
        "issuer_name",
        "instrument_id",
        "title",
        "native_document_id",
        "canonical_url",
        "binding_basis",
        "identity_anchors"
      ],
      "title": "FormalDocumentIdentity",
      "type": "object"
    },
    "FormalDocumentLocation": {
      "additionalProperties": false,
      "description": "An original normalized character interval or an explicit metadata field.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "maximum": 350,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "start": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "field"
      ],
      "title": "FormalDocumentLocation",
      "type": "object"
    },
    "FormalDocumentVerification": {
      "additionalProperties": false,
      "properties": {
        "first_seen_at": {
          "format": "date-time",
          "title": "First Seen At",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/FormalDocumentIdentity"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "text/html",
            "text/plain"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "normalized_original_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Normalized Original Sha256",
          "type": "string"
        },
        "pit_cutoff": {
          "format": "date-time",
          "title": "Pit Cutoff",
          "type": "string"
        },
        "publication_evidence": {
          "items": {
            "$ref": "#/$defs/PublicationDateEvidence"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Publication Evidence",
          "type": "array"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "rights_snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rights Snapshot Sha256",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "publication_evidence",
        "published_at",
        "source_id",
        "normalized_original_sha256",
        "rights_snapshot_sha256",
        "first_seen_at",
        "pit_cutoff",
        "media_type"
      ],
      "title": "FormalDocumentVerification",
      "type": "object"
    },
    "PublicationDateEvidence": {
      "additionalProperties": false,
      "properties": {
        "canonical_url": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https://",
          "title": "Canonical Url",
          "type": "string"
        },
        "kind": {
          "enum": [
            "official_index",
            "official_file_metadata",
            "document_disclosure",
            "official_page_structured"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/FormalDocumentLocation"
        },
        "observation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "instant"
          ],
          "title": "Precision",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "raw_value": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "timezone": {
          "enum": [
            "Asia/Shanghai",
            "UTC"
          ],
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "raw_value",
        "published_at",
        "precision",
        "timezone",
        "canonical_url",
        "location",
        "observation_sha256",
        "receipt_id"
      ],
      "title": "PublicationDateEvidence",
      "type": "object"
    },
    "ResearchCalculation": {
      "additionalProperties": false,
      "properties": {
        "cutoff": {
          "format": "date-time",
          "title": "Cutoff",
          "type": "string"
        },
        "formula": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Formula",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ResearchCalculationInput"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "rule_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "formula",
        "rule_version",
        "inputs",
        "cutoff"
      ],
      "title": "ResearchCalculation",
      "type": "object"
    },
    "ResearchCalculationInput": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{1,99}$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "evidence_ids"
      ],
      "title": "ResearchCalculationInput",
      "type": "object"
    },
    "ResearchClaim": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchCalculation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "counter_evidence": {
          "items": {
            "$ref": "#/$defs/ResearchEvidenceCitation"
          },
          "maxItems": 100,
          "title": "Counter Evidence",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ResearchEvidenceCitation"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        },
        "falsification_conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Falsification Conditions",
          "type": "array"
        },
        "publication_eligible": {
          "title": "Publication Eligible",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "2.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "$ref": "#/$defs/ResearchSectionKind"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "schema_version",
        "claim_type",
        "section",
        "statement",
        "publication_eligible"
      ],
      "title": "ResearchClaim",
      "type": "object"
    },
    "ResearchEvidenceAcquisitionMode": {
      "enum": [
        "built_in_api",
        "model_assisted_web"
      ],
      "title": "ResearchEvidenceAcquisitionMode",
      "type": "string"
    },
    "ResearchEvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "acquisition_mode": {
          "$ref": "#/$defs/ResearchEvidenceAcquisitionMode",
          "default": "built_in_api"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "first_seen_at": {
          "format": "date-time",
          "title": "First Seen At",
          "type": "string"
        },
        "formal_document": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalDocumentCitation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "independent_source_group": {
          "pattern": "^[a-z][a-z0-9_.-]{1,99}$",
          "title": "Independent Source Group",
          "type": "string"
        },
        "locator": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "reliability_factor": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "title": "Reliability Factor",
          "type": "string"
        },
        "revision_known_at": {
          "format": "date-time",
          "title": "Revision Known At",
          "type": "string"
        },
        "rights_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Snapshot Sha256"
        },
        "source_label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Label",
          "type": "string"
        },
        "source_level": {
          "$ref": "#/$defs/ResearchEvidenceSourceLevel",
          "default": "synthetic"
        },
        "source_provider_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,99}$",
          "title": "Source Provider Id",
          "type": "string"
        },
        "source_role": {
          "pattern": "^[a-z][a-z0-9_.-]{1,99}$",
          "title": "Source Role",
          "type": "string"
        },
        "verification_status": {
          "$ref": "#/$defs/ResearchEvidenceVerificationStatus",
          "default": "independently_verified"
        }
      },
      "required": [
        "evidence_id",
        "source_provider_id",
        "independent_source_group",
        "source_role",
        "source_label",
        "published_at",
        "first_seen_at",
        "revision_known_at",
        "locator"
      ],
      "title": "ResearchEvidenceCitation",
      "type": "object"
    },
    "ResearchEvidenceSourceLevel": {
      "enum": [
        "regulatory_official",
        "company_official",
        "trusted_media_data",
        "synthetic"
      ],
      "title": "ResearchEvidenceSourceLevel",
      "type": "string"
    },
    "ResearchEvidenceVerificationStatus": {
      "enum": [
        "independently_verified",
        "single_source",
        "unverified"
      ],
      "title": "ResearchEvidenceVerificationStatus",
      "type": "string"
    },
    "ResearchGlossaryItem": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "term": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term",
        "explanation"
      ],
      "title": "ResearchGlossaryItem",
      "type": "object"
    },
    "ResearchReaderEdition": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "compiler_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Compiler Version",
          "type": "string"
        },
        "glossary": {
          "items": {
            "$ref": "#/$defs/ResearchGlossaryItem"
          },
          "maxItems": 30,
          "title": "Glossary",
          "type": "array"
        },
        "how_the_company_makes_money": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "How The Company Makes Money",
          "type": "array"
        },
        "main_risks": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Main Risks",
          "type": "array"
        },
        "main_strengths": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Main Strengths",
          "type": "array"
        },
        "one_sentence_takeaway": {
          "maxLength": 500,
          "minLength": 1,
          "title": "One Sentence Takeaway",
          "type": "string"
        },
        "public_analysis_steps": {
          "items": {
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Public Analysis Steps",
          "type": "array"
        },
        "safe_markdown": {
          "maxLength": 50000,
          "minLength": 1,
          "title": "Safe Markdown",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Unknowns",
          "type": "array"
        },
        "why_this_score": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Why This Score",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "one_sentence_takeaway",
        "how_the_company_makes_money",
        "why_this_score",
        "main_strengths",
        "main_risks",
        "public_analysis_steps",
        "claim_ids",
        "safe_markdown",
        "compiler_version"
      ],
      "title": "ResearchReaderEdition",
      "type": "object"
    },
    "ResearchReportSection": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 500,
          "title": "Claim Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ResearchSectionKind"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "summary"
      ],
      "title": "ResearchReportSection",
      "type": "object"
    },
    "ResearchScoreBasis": {
      "enum": [
        "real_evidence",
        "synthetic_scenario"
      ],
      "title": "ResearchScoreBasis",
      "type": "string"
    },
    "ResearchScoreDimension": {
      "additionalProperties": false,
      "properties": {
        "adjusted_score": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjusted Score"
        },
        "counter_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Counter Evidence Ids",
          "type": "array"
        },
        "dimension": {
          "$ref": "#/$defs/ResearchScoreDimensionId"
        },
        "display_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "evidence_grade": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Grade"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "raw_score": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Score"
        },
        "reasons": {
          "items": {
